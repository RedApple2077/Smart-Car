{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SC_BENCH_BLUETOOTH": false
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SC_BENCH_BLUETOOTH": false
            }
        },
        {
            "name": "Bench",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/Bench",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SC_BENCH_BLUETOOTH": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Bench",
            "configurePreset": "Bench"
        }
    ]
}
